# =============================================================================
# Automação de Restaurante — variáveis de ambiente
# Copie para .env e preencha. Um único arquivo serve ao Next.js e ao docker compose.
# Gere segredos com:  openssl rand -hex 32
# Detalhes de cada variável: specs/arquitetura.md#variáveis-de-ambiente
# =============================================================================

# --- App (Next.js) -----------------------------------------------------------
APP_URL=http://localhost:3000
# Local: arquivo SQLite. Deploy: libsql://<banco>.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Login único do painel /admin
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=troque-esta-senha
# >= 32 caracteres
SESSION_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Header x-api-key exigido em /api/bot/* (o n8n usa o mesmo valor). >= 16 caracteres
BOT_API_KEY=troque-por-uma-chave-do-bot

# --- Integração Next.js <-> n8n ---------------------------------------------
# Como o Next.js alcança o n8n (notificações e encaminhamento do WhatsApp)
N8N_URL=http://localhost:5678
# Header x-webhook-secret dos webhooks internos do n8n. >= 16 caracteres
N8N_WEBHOOK_SECRET=troque-por-um-segredo-interno
# Como o n8n (dentro do Docker) alcança o Next.js
NEXT_API_URL=http://host.docker.internal:3000

# --- Pagamento Pix -----------------------------------------------------------
# mock = sem conta externa (caminho rápido) | abacatepay = sandbox real
PAGAMENTO_PROVEDOR=mock
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=troque-por-um-segredo-do-webhook
# true habilita o botão "Simular pagamento" no admin
ABACATEPAY_DEV_MODE=true

# --- WhatsApp Cloud API (Meta) — veja docs/setup-meta-whatsapp.md -------------
# Usadas pelo Next.js (gateway do webhook)
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-de-verificacao
WHATSAPP_APP_SECRET=
# Usadas pelo n8n (envio de mensagens)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- IA (Gemini, free tier) — veja docs/setup-gemini.md -----------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Infra do n8n (docker compose) -------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-esta-senha-do-postgres
POSTGRES_DB=n8n
# Chave que criptografa as credenciais no banco do n8n (não mude depois do 1º uso)
N8N_ENCRYPTION_KEY=troque-por-uma-chave-de-criptografia

# --- Túnel público (ngrok, profile "tunel") ----------------------------------
NGROK_AUTHTOKEN=
# Domínio estático gratuito do seu painel ngrok, ex.: meu-restaurante.ngrok-free.app
NGROK_DOMAIN=
