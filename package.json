{
  "name": "automacao-restaurante",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrar.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts",
    "e2e:admin": "node scripts/e2e-admin.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f n8n-bootstrap n8n",
    "infra:reset": "node -e \"console.log(String.fromCodePoint(9888)+'  Apagando volumes do n8n e do Postgres (workflows, credenciais e histórico de chat)...')\" && docker compose down -v && docker compose up -d",
    "tunel:up": "docker compose --profile tunel up -d ngrok",
    "n8n:import": "docker compose run --rm n8n-bootstrap && docker compose restart n8n",
    "n8n:export": "tsx scripts/n8n-export.ts",
    "smoke": "tsx scripts/smoke-chat.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright-core": "1.64.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.18.0"
}
